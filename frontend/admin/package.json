  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint . --fix",
    "lint:check": "eslint . --max-warnings=0",
    "typecheck": "tsc -b",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
